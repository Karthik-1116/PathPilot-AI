# ---------------------------------------------------------------------------
# PathPilot AI environment variables
# Copy this file to .env.local and fill in real values when the related phase
# begins. Never commit .env.local or real keys.
# ---------------------------------------------------------------------------

# Supabase — Phase 2 (dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Used by trusted server code only — never expose it in the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — Phase 5 (https://aistudio.google.com/apikey)
# Server-only. Never prefix this key with NEXT_PUBLIC_ or send it to the browser.
GEMINI_API_KEY=
# Optional model overrides. Use models enabled for your API key.
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the primary model times out or is unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Keep the total Gemini budget below the route maxDuration of 60 seconds.
GEMINI_PRIMARY_TIMEOUT_MS=15000
GEMINI_FALLBACK_TIMEOUT_MS=35000
GEMINI_TOTAL_TIMEOUT_MS=50000
# Optional per-user safeguard for roadmap generations in a rolling 24 hours.
ROADMAP_DAILY_LIMIT=10

# Public site URL used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
